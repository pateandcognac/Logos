{
	"context": {
		"header_name": "prelude_hooks",
		"footer_name": "live_hooks",
		"show_header_stats": false,
		"show_footer_stats": false,
		"show_io_buffer_stats": true,
		"show_io_cell_stats": false,
		"show_hook_ttl": true,
		"token_estimation_divisor": 5,
		"remove_header_at_eol": false,
		"remove_footer_at_eol": false
	},
	"main_model": {
		"model": "gemini-flash-latest",
		"temperature": 0.7,
		"thinking_config": {
			"include_thoughts": true,
			"thinking_budget": 256,
		},
		"retry_config": {
			"max_retries": 8,
			"backoff_factor_s": 2
		},
		"api_throttling": {
			"enabled": true,
			"delay_per_call_s": 1,
			"max_delay_s": 10
		},
		"stop_sequences": [
			"</me>",
			"<py_result>"
		],
		"max_output_tokens": 8096,
		"media_resolution": "MEDIA_RESOLUTION_UNSPECIFIED"
	},
	"llm_tool_models": {
		"aliases": {
			"smartest": "gemini-2.5-pro",
			"fast": "gemini-flash-latest",
			"fastest": "gemini-flash-lite-latest"
		}
	},
	"python": {
		"default_timeout": 3600
	},
	"agent_settings": {
		"global_max_io_buffer_media": 10
	},
	"io_safety_limits": {
		"max_content_chars": 32768,
		"truncate_keep_head": 8000,
		"truncate_keep_tail": 8000
	}
}