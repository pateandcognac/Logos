{
	"context": {
		"header_name": "arche",
		"footer_name": "ephemera",
		"show_header_stats": false,
		"show_footer_stats": false,
		"io_buffer_name": "palimpsest",
		"show_io_buffer_stats": true,
		"show_io_cell_stats": false,
		"token_estimation_divisor": 5
	},
	"main_model": {
		"_model": "gemma-4-26b-a4b-it",
		"_model": "gemma-4-31b-it",
		"model": "gemini-robotics-er-1.6-preview",
		"_model": "gemini-3.1-flash-lite-preview",
		"_model": "gemini-3-flash-preview",
		"_model": "gemini-2.5-pro",
		"_model": "gemini-2.5-flash",
		"_model": "gemini-2.5-flash-lite",
		"temperature": 1.0,
		"thinking_config": {
			"include_thoughts": true,
			"thinking_budget": 128
		},
		"retry_config": {
			"max_retries": 8,
			"backoff_factor_s": 2
		},
		"api_throttling": {
			"enabled": true,
			"delay_per_call_s": 1,
			"max_delay_s": 10
		},
		"stop_sequences": [
			"</me>",
			"<py_result>"
		],
		"max_output_tokens": 32000,
		"_media_resolution": "MEDIA_RESOLUTION_UNSPECIFIED",
		"media_resolution": "MEDIA_RESOLUTION_MEDIUM"
	},
	"llm_tool_models": {
		"aliases": {
			"smartest": "gemini-3.1-pro-preview",
			"fast": "gemini-3-flash-preview",
			"fastest": "gemini-3.1-flash-lite-preview"
		}
	},
	"python": {
		"default_timeout": 36000,
		"preload_snippet": ".system/py_env_preload.py"
	},
	"agent_settings": {
		"global_max_io_buffer_media": 10
	},
	"io_safety_limits": {
		"max_content_chars": 32768,
		"truncate_keep_head": 8000,
		"truncate_keep_tail": 8000
	}
}
