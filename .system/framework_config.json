{
    "context": {
        "header_name": "prelude_context",
        "footer_name": "live_context",
        "show_header_stats": true,
        "show_footer_stats": true,
        "show_io_buffer_stats": true,
        "show_io_cell_stats": true,
        "show_routine_ttl": true,
        "token_estimation_divisor": 5,
        "remove_header_at_eol": false,
        "remove_footer_at_eol": false
    },
    "main_model": {
        "model": "gemini-flash-latest",
        "temperature": 0.7,
        "thinking_config": {
            "include_thoughts": true,
            "thinking_budget": -1
        },
        "stop_sequences": ["</me>", "<py_result>", "</text>"],
        "max_output_tokens": 8096,
        "media_resolution": "MEDIA_RESOLUTION_UNSPECIFIED"
    },
    "python": {
        "preload_api_files": ["core.py","filename2.py"],
        "default_timeout": 3600
    },
    "agent_settings": {
        "global_max_io_buffer_media": 10
    },
    "io_safety_limits": {
        "max_content_chars": 24000,
        "truncate_keep_head": 4000,
        "truncate_keep_tail": 4000
    }
}