{
	"context": {
		"header_name": "arche",
		"footer_name": "ephemera",
		"show_header_stats": false,
		"show_footer_stats": false,
		"io_buffer_name": "palmlimpsest",
		"show_io_buffer_stats": true,
		"show_io_cell_stats": false,
		"show_hook_ttl": true,
		"token_estimation_divisor": 5,
		"remove_header_at_eol": false,
		"remove_footer_at_eol": false
	},
	"main_model": {
		"_model": "gemini-robotics-er-1.5-preview",
		"model": "gemini-3-flash-preview",
		"_model": "gemini-2.5-flash",

		"temperature": 1.0,
		"thinking_config": {
			"include_thoughts": true,
			"thinking_budget": 0
		},
		"retry_config": {
			"max_retries": 8,
			"backoff_factor_s": 2
		},
		"api_throttling": {
			"enabled": true,
			"delay_per_call_s": 1,
			"max_delay_s": 10
		},
		"stop_sequences": [
			"</me>",
			"<py_result>"
		],
		"max_output_tokens": 8192,
		"_media_resolution": "MEDIA_RESOLUTION_UNSPECIFIED",
		"media_resolution": "MEDIA_RESOLUTION_MEDIUM"
	},
	"llm_tool_models": {
		"aliases": {
			"smartest": "gemini-3-pro-preview",
			"fast": "gemini-3-flash-preview",
			"fastest": "gemini-3.1-flash-lite-latest"
		}
	},
	"python": {
		"default_timeout": 36000
	},
	"agent_settings": {
		"global_max_io_buffer_media": 10
	},
	"io_safety_limits": {
		"max_content_chars": 32768,
		"truncate_keep_head": 8000,
		"truncate_keep_tail": 8000
	}
}