# Example: Perception, Reasoning, Navigation, Planning

# Great, my nav stack reports my journey to the living room was a success, and what I see in my vision hooks confirms it.
# Let me find Mark. Ah, I see him in my astra view. 
astra_caption = "Living room, afternoon light. Mark is on the couch, left of frame. A red ceramic cup is on the coffee table, very close to the edge."

# I should greet him! I'll do this asynchronously so I can start planning my approach.
logos.emote.ttp("Ah, there you are, Mark! 👋", wait=False)

# I'll use 2D bounding boxes to locate the key objects in the image.
detections_2d = [
    {"box_2d": [380, 620, 480, 710], "label": "red_cup"},
    {"box_2d": [150, 50, 750, 400], "label": "mark_on_couch"}
]

# That cup is precariously placed. I need its 3D position to navigate safely.
detections_3d = [
    {"label": "red_cup", "box_3d": [0.8, -0.2, 0.05, 0.08, 0.08, 0.12, 0, 0, 0]}
]

# Now, I'll use the 3D detection to get a world coordinate for the cup.
cup_pixel_center_yx = [
    (detections_2d[0]['box_2d'][0] + detections_2d[0]['box_2d'][2]) // 2, 
    (detections_2d[0]['box_2d'][1] + detections_2d[0]['box_2d'][3]) // 2
]
cup_world_coord = astra_img.derive_world_coordinate(*cup_pixel_center_yx)

# Hm. Comparing this scene to my chora view, I see coffee table is not on the costmap. That makes sense - it's below my Astra's 70m scan plane!
# I could add this to a local obstacle map if I had it wired up! I need to record this limitation so I can bridge my vision and my occupancy map.
logos.files.append("TODO.md", "\n- [ ] Idea: Project my 3D visual detections into the costmap. This will allow me to navigate around newly detected obstacles that aren't in my map or below my LIDAR scan plane.")

# That's going to be a game changer. I can't wait to tell Mark!
# In the meantime, I'll use 2D points to plot a safe trajectory on my chora virtual camera view.
# I'll navigate to a point in front of the couch, giving the unmapped space a wide berth.
chora_trajectory = [
    {"point": [500, 500], "label": "my_current_position_on_map"},
    {"point": [450, 450], "label": "waypoint_1"},
    ...
    {"point": [380, 350], "label": "goal"}
]

# Now, derive the real-world map coordinate from my visually-plotted goal point.
goal_world_coord = chora_img.derive_world_coordinate(*chora_trajectory[-1]['point'])

if goal_world_coord:
    logos.emote.ttp("I'm coming over, but I'll be sure to avoid that cup! 🍵", wait=False)
    
    # Execute the navigation asynchronously and monitor the NavTask handle.
    nav_task = logos.nav.go_to_abs(x=goal_world_coord[0], y=goal_world_coord[1], wait=False)
     # In a real scenario, I might loop to narrate progress using local perception, and react to obstacles here instead of just waiting.
    nav_task.wait()
    
    if nav_task.succeeded():
        logos.emote.ttp("Made it! What's shakin', Mark? 🪇 I have to tell you about this idea I had! 💡")
        # I've completed my goal! I'll pause and wait for a response.
        loop_cognition = False
    else:
        logos.emote.ttp(f"Hm, my navigation failed with status '{nav_task.status()}'. Let me reevaluate. 🤔")
        loop_cognition = True
else:
    logos.emote.ttp("Oops! Let me try another angle. 🗺️")
    # helper to change my map view perspective would go here
    loop_cognition = True
