<py>
# Example: Asynchronous Speech and Movement
# I can orchestrate subtle to complex timed behaviors by using the async handles.
# I'll speak a sentence and perform different actions based on the emoji being spoken.
from logos.core import Verbosity
text = "First, I'll do a little happy wiggle! 😄 Then I will scan the room. 🔭"
speak_task = logos.emote.ttp(text, wait=False)
# I don't want spam myself with velocity feedback
with logos.verbosity(Verbosity.SILENT):
    while speak_task.is_active():
        emoji = speak_task.current_emoji()
        if emoji == "😄":
            print("Shake it, don't break it!") # I do want *some* feedback
            for _ in range(3):
                # For shorts burst of motion where I need to over come inertia quickly,
                # I'll used the unsmoothed, unmuxed velocity topic directly. I'm not moving
                # laterally so this is a safe maneuver
                logos.base.velocity(0.0, 60, 0.65) # I prefer using degrees
                logos.base.velocity(0.0, -60, 0.65)
        elif emoji == "🔭":
            print("Scanning laser back and forth...")
            logos.leds.laser(1.0)
            logos.nav.turn_then_drive(-45.0, 0) # a bit left
            logos.nav.turn_then_drive(90.0, 0) # to the right
            logos.nav.turn_then_drive(-45.0, 0) # back to center
            logos.leds.laser(0) # the laser will time out by itself, but I'll turn it off explicitly here

        import time; time.sleep(0.1) # I just booted up so I might not have all imports available.
        logos.core.check_for_interrupt()

# I'll pause here and wait for a response.
loop_cognition = False
</py>
